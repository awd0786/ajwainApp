{
  "expo": {
    "name": "Ajwain TrioTree",
    "slug": "sprint-dashboard-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/ajwain-app-icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.triotree.ajwain",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Allow Ajwain to use Face ID to sign you in."
      }
    },
    "android": {
      "package": "com.triotree.ajwain",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#03081E"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "4e71dd6b-757c-4d26-b93b-f5f69d2dc069"
      }
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Ajwain to use Face ID to sign you in."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#5B4BF5",
          "defaultChannel": "ajwain-default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-splash-screen"
    ]
  }
}
